# Optional: absolute API origin (no trailing slash). When unset, same-origin /api/* uses the Vite dev proxy (see vite.config.ts → localhost:8000).
# VITE_LUX_BASE_URL=https://api.example.com

# Point at a remote Gunnr (or Veritas) API instead of the dev proxy:
# VITE_GUNNR_API_URL=https://your-staging-api.example.com
