# Optional: absolute Gunnr API URL (staging/prod). No trailing slash. When unset, `/api/*` uses same origin (Vite proxy in dev).
# VITE_GUNNR_API_URL=https://your-staging-api.example.com

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: Firebase Analytics (main.tsx)
# VITE_FIREBASE_MEASUREMENT_ID=
# Optional: Mixpanel (see lib/mixpanel.ts)
# VITE_MIXPANEL_TOKEN=
#
# LOCAL ONLY — UI without local API (see README.md)
# VITE_DEV_UI_ONLY=true
