{
  "name": "lux",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "codegen": "openapi-typescript ${VERITAS_OPENAPI:-./openapi.json} -o packages/core/src/generated.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "openapi-typescript": "^7.4.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  }
}
