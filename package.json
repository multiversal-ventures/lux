{
  "name": "lux",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "codegen": "node scripts/codegen.mjs"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.10",
      "protobufjs": "^7.5.5",
      "uuid": ">=11.1.1"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "openapi-typescript": "^7.4.0",
    "turbo": "^2.9.14",
    "typescript": "^5.7.0"
  }
}
